# Copy to .env.production (not committed) before `npm run build`, or to .env.local for `npm run dev`.
# The FastAPI backend's public URL, no trailing slash.
VITE_API_URL=https://your-api.example.com
# Where this site is served, no trailing slash: used for link-preview (Open Graph) tags.
VITE_SITE_URL=https://your-site.example.com
