# LiteLLM model names ("<provider>/<model>"); the model must accept images.
LLM_MODEL=deepseek/deepseek-flash
LLM_FALLBACKS=["gemini/gemini-3.8-flash"]
LLM_TIMEOUT=30
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
EXA_API_KEY=

# Product search embeddings (EmbeddingGemma 2, runs in-process; ~3.3 GB RAM)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=google/embeddinggemma-2
# cpu on the server, mps on a Mac
EMBEDDING_DEVICE=cpu
EMBEDDING_IMAGE_TOKENS=140
IMAGE_WEIGHT=0.5

# Leave APPWRITE_PROJECT_ID empty to use the in-memory store locally.
APPWRITE_ENDPOINT=https://sgp.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=better_fssai
APPWRITE_IMAGES_BUCKET=pack-images

# Live voice (Bolna Web Call SDK): minting needs the key server-side.
BOLNA_API_KEY=
BOLNA_AGENT_ID=55133e0b-379d-43da-b121-cf0c1734e041
